              "text": "Попросить Илью показать механизм маяка",
              "conditions": { "lighthouseInterest": 1 },
              "unavailableReason": "Сначала нужно проявить интерес к восстановлению маяка при знакомстве."
            },
            {
              "id": "with_ilya",
              "targetNodeId": "quiet",
              "targetSceneId": "ilya_evening",
              "text": "Остаться у маяка с Ильёй"
            },
            {
              "id": "with_mark",
              "targetNodeId": "boat",
              "targetSceneId": "mark_evening",
              "text": "Прогуляться по гавани с Марком"
            },
            {
              "id": "with_mira",
              "targetNodeId": "tea",
              "targetSceneId": "friends",
              "text": "Выпить чаю с Мирой"
            }
          ]
        }
      },
      "backgroundResource": "files/scenes/lighthouse_room.png"
    },
