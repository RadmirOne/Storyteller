    },
    {
      "id": "mira",
      "name": "Мира",
      "spriteResource": "files/characters/mira.png"
    },
    {
      "id": "ilya",
      "name": "Илья",
      "spriteResource": "files/characters/ilya.png"
    },
    {
      "id": "mark",
      "name": "Марк",
      "spriteResource": "files/characters/mark.png"
    }
  ],
  "startSceneId": "arrival",
