        "friend": {
          "id": "friend",
          "characterId": "mark",
          "text": "Договорились. Без намёков и неловкости. Покажу тебе бухту, которой нет в путеводителе.",
          "stageCharacters": [
            {
              "worldX": 0.5,
              "visible": true,
              "position": "CENTER",
