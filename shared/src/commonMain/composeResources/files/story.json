            "targetCharacterId": "ilya"
          },
          "cameraDurationMs": 0
        },
        "friend": {
          "id": "friend",
          "characterId": "ilya",
          "text": "Конечно. Спасибо, что сказала. Чай и лучшие виды всё равно за мной.",
          "stageCharacters": [
            {
              "worldX": 0.5,
              "visible": true,
              "position": "CENTER",
              "scale": 1,
              "groundY": 0.94,
              "characterId": "ilya"
            }
          ],
          "camera": {
            "targetCharacterId": "ilya"
          },
          "cameraDurationMs": 0
        }
      },
      "backgroundResource": "files/scenes/lighthouse_room.png"
    },
