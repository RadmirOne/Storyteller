  "scenes": {
    "arrival": {
      "id": "arrival",
      "nodes": {
        "welcome": {
          "id": "welcome",
          "characterId": "mira",
          "text": "{{playerName}}, наконец-то! Твоя комната готова. А сегодня мы впервые зажжём отреставрированный маяк.",
          "stageCharacters": [
            {
              "worldX": 0.5,
              "visible": true,
              "position": "CENTER",
              "scale": 1,
              "groundY": 0.94,
              "characterId": "mira"
            }
          ],
          "camera": {
            "targetCharacterId": "mira"
          },
          "cameraDurationMs": 0,
          "nextNodeId": "reply"
        },
        "reply": {
          "id": "reply",
          "characterId": "protagonist",
          "text": "Я приехала всего на выходные. Но уже рада, что ты меня уговорила.",
          "stageCharacters": [],
          "camera": {
            "focusX": 0.5
          },
          "cameraDurationMs": 0,
          "nextNodeId": "ilya"
        },
        "ilya": {
          "id": "ilya",
          "characterId": "ilya",
          "text": "Я Илья. Обещаю показать лучший вид с башни. Если не испугаешься ста восьмидесяти ступеней.",
          "stageCharacters": [
            {
              "worldX": 0.5,
              "visible": true,
              "position": "CENTER",
              "scale": 1,
              "groundY": 0.94,
              "characterId": "ilya"
            }
          ],
          "camera": {
            "targetCharacterId": "ilya"
          },
          "cameraDurationMs": 0,
          "nextNodeId": "mark"
        },
        "mark": {
          "id": "mark",
          "characterId": "mark",
          "text": "А я Марк. У меня предложение без ступеней: вечерняя гавань с катера. Правда, чай придётся держать самой.",
          "stageCharacters": [
            {
              "worldX": 0.5,
              "visible": true,
              "position": "CENTER",
              "scale": 1,
              "groundY": 0.94,
              "characterId": "mark"
            }
          ],
          "camera": {
            "targetCharacterId": "mark"
          },
          "cameraDurationMs": 0,
          "nextNodeId": "smile"
        },
        "smile": {
          "id": "smile",
          "characterId": "protagonist",
          "text": "Вы всегда так встречаете гостей? Теперь мне придётся задержаться, чтобы всё успеть.",
          "stageCharacters": [],
          "camera": {
            "focusX": 0.5
          },
          "cameraDurationMs": 0,
          "choices": [
            {
              "id": "ask_restoration",
              "text": "Илья, мне интересно, как вы восстановили маяк",
              "targetNodeId": "invite",
              "effects": { "add": { "lighthouseInterest": 1 } }
            },
            {
              "id": "enjoy_weekend",
              "text": "Начну с прогулки, а дальше решу",
              "targetNodeId": "invite"
            }
          ]
        },
        "invite": {
          "id": "invite",
          "characterId": "mira",
          "text": "Сначала зажжём маяк. А потом я отпущу тебя гулять — обещаю не расспрашивать до завтра.",
          "stageCharacters": [
            {
              "worldX": 0.5,
              "visible": true,
              "position": "CENTER",
              "scale": 1,
              "groundY": 0.94,
              "characterId": "mira"
            }
          ],
          "camera": {
            "targetCharacterId": "mira"
          },
          "cameraDurationMs": 0,
          "nextNodeId": "light",
          "nextSceneId": "tower"
